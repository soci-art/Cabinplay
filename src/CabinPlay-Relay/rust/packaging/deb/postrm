set -e
unit=cabinplay-relay.service
if [ -d /run/systemd/system ]; then systemctl --system daemon-reload >/dev/null || :; fi
if [ "$1" = remove ] && [ -x /usr/bin/deb-systemd-helper ]; then
    deb-systemd-helper mask "$unit" >/dev/null || :
fi
# Trusted HTTPS: the local DNS answer the relay writes for NetworkManager's hotspot dnsmasq.
if [ "$1" = remove ] || [ "$1" = purge ]; then
    rm -f /etc/NetworkManager/dnsmasq-shared.d/cabinplay-public-name.conf
fi
if [ "$1" = purge ]; then
    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper purge "$unit" >/dev/null || :
        deb-systemd-helper unmask "$unit" >/dev/null || :
    fi
    rm -rf /var/cache/cabinplay/relay
    rmdir /var/cache/cabinplay 2>/dev/null || :
    # The state directory holds the owner's accessory identity and pairings: never deleted here.
    if [ -d /var/lib/cabinplay ]; then
        echo 'cabinplay-relay: kept /var/lib/cabinplay (identity, pairings, settings); delete it yourself if wanted.'
    fi
fi
exit 0
